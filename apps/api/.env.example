# Copy to .env.local (gitignored); `pnpm dev:api` loads it.
# Comma-separated emails allowed to manage the 我的猫咪 gallery.
ADMIN_EMAILS=you@example.com
# Optional overrides:
# FFMPEG=/opt/homebrew/bin/ffmpeg        (macOS; on Windows ffmpeg on PATH works)
# Database URLs; defaults are picked per platform by scripts/dev.mjs:
#   macOS:   postgres:///catchat?host=/tmp
#   Windows: postgres://postgres@localhost:5432/catchat?sslmode=disable
#            (password from %APPDATA%\postgresql\pgpass.conf)
# DATABASE_URL=
# TEST_DATABASE_URL=
# IMAGE_DIR=data/images
# VIDEO_DIR=data/videos

# Verification email (sign-up codes). Without RESEND_API_KEY, emails are
# written to data/mail/ (DEV_MAIL_DIR) and logged instead of sent.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=MeowSphere <noreply@your-verified-domain.com>

# Local testing only: make every verification code this value. The server
# refuses to start if this is set together with RESEND_API_KEY.
# DEV_FIXED_CODE=123456
